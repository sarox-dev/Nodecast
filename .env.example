APP_HOST=0.0.0.0
APP_PORT=5000
# Keep Nodecast local by default. Set to 0.0.0.0 only for a trusted LAN.
NODECAST_BIND_HOST=127.0.0.1
NODECAST_ACCOUNT_MODE=personal
NODECAST_UID=1000
NODECAST_GID=1000
NODECAST_PUBLIC_ORIGIN=http://localhost:5000
NODECAST_CORS_ORIGINS=
JWT_SECRET=
JWT_EXPIRY_HOURS=72
COOKIE_SECURE=false
ENCRYPTION_KEY=
AUTO_UPDATE_DEFAULT=false
MAX_REQUEST_BYTES=12582912
MAX_SNAPSHOT_BYTES=10485760
MAX_USER_STORAGE_BYTES=1073741824
